{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tangram-puzzle/1",
  "title": "TangramNoAds puzzle (tangram-puzzle/1)",
  "description": "Structural schema only. Geometric rules (congruence, overlap, connectivity) are enforced by tools/validate_puzzles.py. See Spec/03-puzzle-format.md.",
  "type": "object",
  "required": [
    "format",
    "id",
    "title",
    "category",
    "difficulty",
    "solution",
    "art"
  ],
  "properties": {
    "format": {
      "const": "tangram-puzzle/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "category": {
      "enum": [
        "shapes",
        "animals",
        "people",
        "things",
        "vehicles",
        "nature",
        "letters",
        "numbers"
      ]
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "solution": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/placement"
      }
    },
    "assist": {
      "type": "object",
      "properties": {
        "preplacedOrder": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pieceId"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "celebrate": {
      "type": "object",
      "properties": {
        "sound": {
          "type": "string"
        },
        "eyes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "author": {
          "type": "string",
          "pattern": "^(human|ai):.+$"
        },
        "reviewedByHuman": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "art": {
      "type": "object",
      "required": [
        "base",
        "shapes"
      ],
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "shapes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "points"
                ],
                "properties": {
                  "type": {
                    "const": "polygon"
                  },
                  "points": {
                    "type": "array",
                    "minItems": 3,
                    "items": {
                      "$ref": "#/$defs/fpoint"
                    }
                  },
                  "fill": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "stroke": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "properties": {
                  "type": {
                    "const": "rect"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  },
                  "rx": {
                    "type": "number"
                  },
                  "fill": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "stroke": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "c",
                  "r"
                ],
                "properties": {
                  "type": {
                    "const": "circle"
                  },
                  "c": {
                    "$ref": "#/$defs/fpoint"
                  },
                  "r": {
                    "type": "number"
                  },
                  "fill": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "stroke": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "c",
                  "rx",
                  "ry"
                ],
                "properties": {
                  "type": {
                    "const": "ellipse"
                  },
                  "c": {
                    "$ref": "#/$defs/fpoint"
                  },
                  "rx": {
                    "type": "number"
                  },
                  "ry": {
                    "type": "number"
                  },
                  "fill": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "stroke": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "from",
                  "to",
                  "stroke"
                ],
                "properties": {
                  "type": {
                    "const": "line"
                  },
                  "from": {
                    "$ref": "#/$defs/fpoint"
                  },
                  "to": {
                    "$ref": "#/$defs/fpoint"
                  },
                  "fill": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "stroke": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "d"
                ],
                "properties": {
                  "type": {
                    "const": "path"
                  },
                  "d": {
                    "type": "string"
                  },
                  "fill": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "stroke": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pieceId": {
      "enum": [
        "LT1",
        "LT2",
        "MT",
        "ST1",
        "ST2",
        "SQ",
        "PG"
      ]
    },
    "coord": {
      "description": "Rational number, or [a, b] meaning a + b*sqrt(2)",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "point": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/coord"
        },
        {
          "$ref": "#/$defs/coord"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "placement": {
      "type": "object",
      "required": [
        "piece"
      ],
      "properties": {
        "piece": {
          "$ref": "#/$defs/pieceId"
        },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "rot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "flip": {
          "type": "boolean"
        },
        "at": {
          "$ref": "#/$defs/point"
        }
      },
      "oneOf": [
        {
          "required": [
            "polygon"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "rot"
                ]
              },
              {
                "required": [
                  "at"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "at"
          ],
          "not": {
            "required": [
              "polygon"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "fpoint": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}